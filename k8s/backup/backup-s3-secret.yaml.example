# Mau Secret cho backup S3 — guide muc 13.1. TUY CHON.
# Copy thanh backup-s3-secret.yaml, dien key that, roi apply.
# KHONG commit file da dien key.
apiVersion: v1
kind: Secret
metadata:
  name: backup-s3-secret
  namespace: production
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: CHANGE_ME
  AWS_SECRET_ACCESS_KEY: CHANGE_ME
